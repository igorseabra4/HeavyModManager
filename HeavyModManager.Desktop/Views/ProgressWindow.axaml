<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HeavyModManager.Desktop.Views.ProgressWindow"
        Title="Working..."
        Width="440"
        Height="160"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Name="TextBlockStatus"
                   Text="Processing..."
                   FontSize="14"
                   Margin="0,0,0,12" />
        <ProgressBar Name="ProgressBarTask"
                     Grid.Row="1"
                     Height="16"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Margin="0,0,0,8" />
        <TextBlock Name="TextBlockPercent"
                   Grid.Row="2"
                   Text="0%"
                   FontSize="12"
                   HorizontalAlignment="Right"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Grid>
</Window>
